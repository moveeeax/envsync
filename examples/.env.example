# Schema-annotated example. Annotations live in comments and apply to the
# variable on the next line (or inline after the value).
#
#   @type=int|bool|url|enum(a,b,c)   declares the expected value type
#   @required                        the variable must be present and non-empty

# @type=int @required
PORT=8080

# @type=enum(dev,staging,prod) @required
APP_ENV=dev

# @type=url @required
DATABASE_URL=postgres://localhost:5432/app

# @type=bool
DEBUG=false

# @type=int
REQUEST_TIMEOUT=30

# free-form string, optional
LOG_PREFIX=app
